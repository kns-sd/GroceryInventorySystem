@model List<GroceryInventorySystem.Models.Sale>
@{
    ViewData["Title"] = "Sales History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-clock-history me-2"></i>Sales History</h3>
    <div class="d-flex gap-2">
        <input type="date" id="dateFilter" class="form-control" onchange="filterByDate()">
        <a href="/Sales/Index" class="btn btn-primary">
            <i class="bi bi-cart-plus me-1"></i>New Sale
        </a>
    </div>
</div>

<div class="card dashboard-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="salesTable">
                <thead class="table-light">
                    <tr>
                        <th>Sale ID</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var sale in Model)
                        {
                            <tr class="sale-row" data-date="@sale.SaleDate.ToString("yyyy-MM-dd")">
                                <td><span class="badge bg-primary">#@sale.Id.ToString("D4")</span></td>
                                <td class="fw-bold">@(sale.Product?.Name ?? "Unknown")</td>
                                <td><span class="badge bg-info text-dark">@(sale.Product?.Category ?? "-")</span></td>
                                <td>@sale.Quantity</td>
                                <td>৳ @((sale.TotalPrice / sale.Quantity).ToString("F2"))</td>
                                <td class="fw-bold text-success">৳ @sale.TotalPrice.ToString("F2")</td>
                                <td>@sale.SaleDate.ToString("dd MMM yyyy")</td>
                                <td>@sale.SaleDate.ToString("hh:mm tt")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                No sales records found.<br>
                                <a href="/Sales/Index" class="btn btn-sm btn-primary mt-2">Make a Sale</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="text-end fw-bold">Grand Total:</td>
                        <td class="fw-bold text-success fs-5">৳ @Model.Sum(s => s.TotalPrice).ToString("F2")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterByDate() {
            const selectedDate = document.getElementById('dateFilter').value;
            const rows = document.querySelectorAll('.sale-row');

            rows.forEach(row => {
                if (!selectedDate || row.getAttribute('data-date') === selectedDate) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}