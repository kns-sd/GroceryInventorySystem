@{
    ViewData["Title"] = "Dashboard";
}

<!-- AI Low Stock Alert -->
@if (ViewBag.LowStockCount > 0)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>AI Alert!</strong> @ViewBag.LowStockCount items are running low!

        <ul class="mt-2 mb-0">
            @foreach (var item in ViewBag.LowStockItems)
            {
                <li>
                    @item.Name - Only @item.StockQuantity left!
                    (Min: @item.MinStockLevel)
                </li>
            }
        </ul>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<!-- AI Business Assistant -->
<div class="card dashboard-card mb-4">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="bi bi-robot me-2"></i>
            AI Business Assistant
        </h5>
    </div>

    <div class="card-body">

        <!-- Chat Messages -->
        <div id="aiChatMessages"
             class="border rounded p-3 mb-3"
             style="height: 350px; overflow-y: auto; background-color: #f8f9fa;">

            <!-- Welcome Message -->
            <div class="d-flex mb-3">
                <div class="bg-primary text-white rounded p-3"
                     style="max-width: 80%;">

                    <strong>
                        <i class="bi bi-robot me-1"></i>
                        AI Assistant
                    </strong>

                    <div class="mt-1">
                        Hello! I can help you understand your
                        grocery business.
                        Ask me about sales, revenue, inventory,
                        low stock, or future sales.
                    </div>

                </div>
            </div>

        </div>

        <!-- Quick Questions -->
        <div class="mb-3">

            <small class="text-muted d-block mb-2">
                Quick questions:
            </small>

            <button type="button"
                    class="btn btn-outline-primary btn-sm me-1 mb-1"
                    onclick="askAI('What is today\\'s revenue?')">
                Today's Revenue
            </button>

            <button type="button"
                    class="btn btn-outline-danger btn-sm me-1 mb-1"
                    onclick="askAI('Which products are low in stock?')">
                Low Stock
            </button>

            <button type="button"
                    class="btn btn-outline-success btn-sm me-1 mb-1"
                    onclick="askAI('What are my top selling products?')">
                Top Products
            </button>

            <button type="button"
                    class="btn btn-outline-warning btn-sm me-1 mb-1"
                    onclick="askAI('Predict my Rice (5kg) sales for next week.')">
                Rice Forecast
            </button>

        </div>

        <!-- Chat Input -->
        <div class="input-group">

            <input type="text"
                   id="aiMessageInput"
                   class="form-control"
                   placeholder="Ask something about your business..."
                   autocomplete="off" />

            <button type="button"
                    id="aiSendButton"
                    class="btn btn-primary"
                    onclick="sendAIMessage()">

                <i class="bi bi-send me-1"></i>
                Send

            </button>

        </div>

    </div>

</div>


<!-- Stats Cards -->
<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-card bg-primary text-white">
            <div class="card-body">
                <h6 class="card-title">Total Products</h6>
                <h2 class="mb-0">@ViewBag.TotalProducts</h2>
                <i class="bi bi-box-seam card-icon"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-card bg-success text-white">
            <div class="card-body">
                <h6 class="card-title">Today's Sales</h6>
                <h2 class="mb-0">
                    ৳ @ViewBag.TodaySales.ToString("F2")
                </h2>
                <i class="bi bi-cart-check card-icon"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-card bg-warning text-dark">
            <div class="card-body">
                <h6 class="card-title">Total Revenue</h6>
                <h2 class="mb-0">
                    ৳ @ViewBag.TotalRevenue.ToString("F2")
                </h2>
                <i class="bi bi-currency-dollar card-icon"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-card bg-danger text-white">
            <div class="card-body">
                <h6 class="card-title">Low Stock Items</h6>
                <h2 class="mb-0">@ViewBag.LowStockCount</h2>
                <i class="bi bi-exclamation-triangle card-icon"></i>
            </div>
        </div>
    </div>

</div>


<!-- Charts Row -->
<div class="row g-4 mb-4">

    <div class="col-lg-8">
        <div class="card dashboard-card">

            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">
                    <i class="bi bi-graph-up me-2"></i>
                    Sales Overview
                </h5>
            </div>

            <div class="card-body">
                <canvas id="salesChart" height="100"></canvas>
            </div>

        </div>
    </div>

    <div class="col-lg-4">
        <div class="card dashboard-card">

            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">
                    <i class="bi bi-pie-chart me-2"></i>
                    Category Distribution
                </h5>
            </div>

            <div class="card-body">
                <canvas id="categoryChart"></canvas>
            </div>

        </div>
    </div>

</div>


<!-- ML.NET Sales Forecast -->
<div class="card dashboard-card mb-4">

    <div class="card-header bg-white border-0 pt-3">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-graph-up-arrow me-2"></i>
                AI Sales Forecast
            </h5>

            <span class="badge bg-primary">
                ML.NET • Next 7 Days
            </span>

        </div>

    </div>

    <div class="card-body">

        @if (ViewBag.ForecastProducts != null &&
             ViewBag.ForecastProducts.Count > 0)
        {
            <div class="row">

                <div class="col-md-4 mb-3">

                    <label class="form-label fw-bold">
                        Select Product
                    </label>

                    <select id="forecastProduct"
                            class="form-select">

                        @for (int i = 0;
                              i < ViewBag.ForecastProducts.Count;
                              i++)
                        {
                            var product =
                                ViewBag.ForecastProducts[i];

                            <option value="@i">
                                @product.ProductName
                            </option>
                        }

                    </select>

                    <div class="mt-4 p-3 bg-light rounded">

                        <small class="text-muted">
                            Predicted sales for next 7 days
                        </small>

                        <h3 id="forecastTotal"
                            class="mt-1 mb-0">
                            -
                        </h3>

                        <small class="text-muted">
                            units
                        </small>

                    </div>

                </div>

                <div class="col-md-8">

                    <canvas id="forecastChart"
                            height="120">
                    </canvas>

                </div>

            </div>

            <div class="alert alert-info mt-4 mb-0">

                <i class="bi bi-info-circle me-2"></i>

                Forecast values are estimates generated from
                historical sales data. They are not guaranteed
                future sales.

            </div>
        }
        else
        {
            <div class="text-center py-4">

                <i class="bi bi-graph-up-arrow display-5 text-muted"></i>

                <h5 class="mt-3">
                    Forecast unavailable
                </h5>

                <p class="text-muted mb-0">
                    Products need at least 10 days of sales history
                    before a forecast can be generated.
                </p>

            </div>
        }

    </div>

</div>


<!-- Recent Transactions -->
<div class="row">

    <div class="col-12">

        <div class="card dashboard-card">

            <div class="card-header bg-white border-0 pt-3
                        d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    Recent Transactions
                </h5>

                <a href="/Sales/History"
                   class="btn btn-sm btn-primary">
                    View All
                </a>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead class="table-light">

                            <tr>
                                <th>ID</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Amount</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @if (ViewBag.RecentSales != null &&
                                 ViewBag.RecentSales.Count > 0)
                            {
                                @foreach (var sale in ViewBag.RecentSales)
                                {
                                    <tr>

                                        <td>
                                            #@sale.Id.ToString("D3")
                                        </td>

                                        <td>
                                            @(sale.Product?.Name ?? "Unknown")
                                        </td>

                                        <td>
                                            @sale.Quantity
                                        </td>

                                        <td>
                                            ৳ @sale.TotalPrice.ToString("F2")
                                        </td>

                                        <td>
                                            @sale.SaleDate.ToString("hh:mm tt")
                                        </td>

                                        <td>
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="6"
                                        class="text-center text-muted py-4">

                                        No sales yet. Make your first sale
                                        from Sales/POS!

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // ==========================================
        // AI CHAT
        // ==========================================

        const aiInput =
            document.getElementById("aiMessageInput");

        const aiSendButton =
            document.getElementById("aiSendButton");

        const aiChatMessages =
            document.getElementById("aiChatMessages");


        function addUserMessage(message) {

            const wrapper =
                document.createElement("div");

            wrapper.className =
                "d-flex justify-content-end mb-3";

            wrapper.innerHTML = `
                <div class="bg-secondary text-white rounded p-3"
                     style="max-width: 80%;">
                    <strong>You</strong>
                    <div class="mt-1"></div>
                </div>
            `;

            wrapper.querySelector("div div").textContent =
                message;

            aiChatMessages.appendChild(wrapper);

            aiChatMessages.scrollTop =
                aiChatMessages.scrollHeight;
        }


        function addAIMessage(message) {

            const wrapper =
                document.createElement("div");

            wrapper.className =
                "d-flex mb-3";

            wrapper.innerHTML = `
                <div class="bg-primary text-white rounded p-3"
                     style="max-width: 80%;">
                    <strong>
                        <i class="bi bi-robot me-1"></i>
                        AI Assistant
                    </strong>
                    <div class="mt-1"></div>
                </div>
            `;

            wrapper.querySelector("div div").textContent =
                message;

            aiChatMessages.appendChild(wrapper);

            aiChatMessages.scrollTop =
                aiChatMessages.scrollHeight;
        }


        function addLoadingMessage() {

            const wrapper =
                document.createElement("div");

            wrapper.id = "aiLoadingMessage";

            wrapper.className =
                "d-flex mb-3";

            wrapper.innerHTML = `
                <div class="bg-primary text-white rounded p-3">
                    <i class="bi bi-three-dots"></i>
                    AI is thinking...
                </div>
            `;

            aiChatMessages.appendChild(wrapper);

            aiChatMessages.scrollTop =
                aiChatMessages.scrollHeight;
        }


        async function sendAIMessage() {

            const message =
                aiInput.value.trim();

            if (!message) {
                return;
            }

            addUserMessage(message);

            aiInput.value = "";

            aiSendButton.disabled = true;

            addLoadingMessage();

            try {

                const formData =
                    new URLSearchParams();

                formData.append(
                    "message",
                    message
                );

                formData.append(
                    "dashboard",
                    "true"
                );


                const response =
                    await fetch(
                        "/AI/Chat",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },

                            body:
                                formData.toString()
                        }
                    );


                const data =
                    await response.json();


                const loading =
                    document.getElementById(
                        "aiLoadingMessage"
                    );

                if (loading) {
                    loading.remove();
                }


                if (data.success) {

                    addAIMessage(
                        data.response
                    );

                }
                else {

                    addAIMessage(
                        "Error: " + data.error
                    );

                }

            }
            catch (error) {

                const loading =
                    document.getElementById(
                        "aiLoadingMessage"
                    );

                if (loading) {
                    loading.remove();
                }

                addAIMessage(
                    "Unable to connect to the AI assistant."
                );

            }
            finally {

                aiSendButton.disabled = false;

                aiInput.focus();

            }
        }


        function askAI(message) {

            aiInput.value = message;

            sendAIMessage();

        }


        // Press Enter to send

        aiInput.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" &&
                    !event.shiftKey
                ) {

                    event.preventDefault();

                    sendAIMessage();

                }

            }
        );


        // ==========================================
        // SALES OVERVIEW CHART
        // ==========================================

        const salesCtx =
            document.getElementById("salesChart")
                .getContext("2d");

        new Chart(salesCtx, {

            type: "line",

            data: {

                labels:
                    @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),

                datasets: [{

                    label: "Sales (৳)",

                    data:
                        @Html.Raw(Json.Serialize(ViewBag.ChartData)),

                    borderColor: "#0d6efd",

                    backgroundColor:
                        "rgba(13, 110, 253, 0.1)",

                    fill: true,

                    tension: 0.4,

                    pointRadius: 5,

                    pointBackgroundColor: "#0d6efd"

                }]

            },

            options: {

                responsive: true,

                plugins: {

                    legend: {
                        display: false
                    }

                },

                scales: {

                    y: {
                        beginAtZero: true
                    }

                }

            }

        });


        // ==========================================
        // CATEGORY PIE CHART
        // ==========================================

        const categoryCtx =
            document.getElementById("categoryChart")
                .getContext("2d");

        new Chart(categoryCtx, {

            type: "doughnut",

            data: {

                labels:
                    @Html.Raw(Json.Serialize(ViewBag.CategoryLabels)),

                datasets: [{

                    data:
                        @Html.Raw(Json.Serialize(ViewBag.CategoryData)),

                    backgroundColor: [
                        "#0d6efd",
                        "#198754",
                        "#ffc107",
                        "#dc3545",
                        "#6c757d",
                        "#6610f2",
                        "#fd7e14"
                    ]

                }]

            },

            options: {

                responsive: true,

                plugins: {

                    legend: {
                        position: "bottom"
                    }

                }

            }

        });


        // ==========================================
        // ML.NET FORECAST CHART
        // ==========================================

        const forecastProducts =
            @Html.Raw(Json.Serialize(ViewBag.ForecastProducts));

        let forecastChart = null;


        function updateForecastChart(index) {

            if (!forecastProducts ||
                forecastProducts.length === 0) {
                return;
            }

            const product =
                forecastProducts[index];

            if (!product) {
                return;
            }


            document.getElementById("forecastTotal")
                .innerText =
                product.totalForecast + " units";


            if (forecastChart !== null) {
                forecastChart.destroy();
            }


            const forecastCtx =
                document.getElementById("forecastChart")
                    .getContext("2d");


            forecastChart = new Chart(
                forecastCtx,
                {

                    type: "line",

                    data: {

                        labels: product.dates,

                        datasets: [

                            {

                                label:
                                    "Predicted Sales",

                                data:
                                    product.predictions,

                                borderColor:
                                    "#0d6efd",

                                backgroundColor:
                                    "rgba(13, 110, 253, 0.1)",

                                fill: true,

                                tension: 0.4,

                                pointRadius: 5

                            },

                            {

                                label:
                                    "Lower Bound",

                                data:
                                    product.lowerBounds,

                                borderDash:
                                    [5, 5],

                                fill: false,

                                tension: 0.4,

                                pointRadius: 3

                            },

                            {

                                label:
                                    "Upper Bound",

                                data:
                                    product.upperBounds,

                                borderDash:
                                    [5, 5],

                                fill: false,

                                tension: 0.4,

                                pointRadius: 3

                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        plugins: {

                            legend: {
                                position: "bottom"
                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                title: {

                                    display: true,

                                    text: "Units"

                                }

                            }

                        }

                    }

                }
            );

        }


        if (forecastProducts &&
            forecastProducts.length > 0) {

            updateForecastChart(0);

        }


        const forecastProduct =
            document.getElementById(
                "forecastProduct"
            );

        if (forecastProduct) {

            forecastProduct.addEventListener(
                "change",
                function () {

                    updateForecastChart(
                        parseInt(this.value)
                    );

                }
            );

        }

    </script>

}