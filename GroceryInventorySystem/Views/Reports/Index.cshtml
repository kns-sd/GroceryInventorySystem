@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-graph-up me-2"></i>Sales Reports</h3>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card dashboard-card bg-primary text-white">
            <div class="card-body">
                <h6>Total Sales</h6>
                <h2>@ViewBag.TotalSales</h2>
                <i class="bi bi-cart-check card-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card dashboard-card bg-success text-white">
            <div class="card-body">
                <h6>Total Revenue</h6>
                <h2>৳ @ViewBag.TotalRevenue.ToString("F2")</h2>
                <i class="bi bi-currency-dollar card-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card dashboard-card bg-info text-white">
            <div class="card-body">
                <h6>Items Sold</h6>
                <h2>@ViewBag.TotalQuantity</h2>
                <i class="bi bi-box-seam card-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Best Selling Products -->
    <div class="col-lg-6">
        <div class="card dashboard-card">
            <div class="card-header bg-white border-0 pt-3">
                <h5><i class="bi bi-trophy me-2"></i>Best Selling Products</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th>Qty Sold</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.BestSelling != null)
                            {
                                int rank = 1;
                                @foreach (var item in ViewBag.BestSelling)
                                {
                                    <tr>
                                        <td>
                                            @if (rank == 1)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill"></i> #1</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">#@rank</span>
                                            }
                                        </td>
                                        <td class="fw-bold">@item.ProductName</td>
                                        <td>@item.TotalQuantity</td>
                                        <td class="text-success fw-bold">৳ @item.TotalRevenue.ToString("F2")</td>
                                    </tr>
                                    rank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales by Category -->
    <div class="col-lg-6">
        <div class="card dashboard-card">
            <div class="card-header bg-white border-0 pt-3">
                <h5><i class="bi bi-pie-chart me-2"></i>Sales by Category</h5>

           